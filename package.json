{
  "name": "cleos-munchies",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "test": "node --test tests/*.test.js",
    "test:e2e": "node scripts/run-playwright.mjs",
    "images:optimize": "node scripts/optimize-menu-images.mjs",
    "check": "npm test && npm run build",
    "admin:dev": "vite --config vite.admin.config.js",
    "admin:build": "vite build --config vite.admin.config.js && node scripts/inline-admin.mjs",
    "worker:dev": "wrangler dev --config worker/wrangler.jsonc --port 8788",
    "worker:migrate:local": "wrangler d1 migrations apply cleos-munchies --local --config worker/wrangler.jsonc",
    "worker:migrate:remote": "wrangler d1 migrations apply cleos-munchies --remote --config worker/wrangler.jsonc",
    "worker:deploy": "wrangler deploy --config worker/wrangler.jsonc",
    "menu:seed": "node scripts/generate-menu-seed.mjs"
  },
  "dependencies": {
    "@vitejs/plugin-react": "latest",
    "react": "latest",
    "react-dom": "latest",
    "vite": "latest"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "wrangler": "4.168.0"
  }
}
